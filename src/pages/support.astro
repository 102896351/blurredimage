---
import Base from '../layouts/Base.astro';
---

<Base title="Support | Toolbox Image" description="Get help with Toolbox Image: FAQ, contact email and troubleshooting for the browser-based image tools." path="/support" lang="en" altLang={null}>
  <div class="support-wrap">
    <section class="support-hero">
      <span class="eyebrow">SUPPORT</span>
      <h1>Contact Toolbox Image</h1>
      <p class="lede">Need help using our tools, have a privacy question, or want to report a problem? Drop us an email — include your browser, device, and a short description of the issue, and we will get back to you.</p>
      <a class="contact-mail" href="mailto:yangkunming2026@gmail.com">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        yangkunming2026@gmail.com
      </a>
    </section>

    <section class="info-grid">
      <article class="info-card">
        <span class="info-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></span>
        <h3>Email</h3>
        <p class="info-main"><a href="mailto:yangkunming2026@gmail.com">yangkunming2026@gmail.com</a></p>
        <p class="info-sub">Best for bug reports, feedback, and privacy questions.</p>
      </article>

      <article class="info-card">
        <span class="info-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
        <h3>Response time</h3>
        <p class="info-main">Usually within 24 hours</p>
        <p class="info-sub">On business days. Detailed technical issues may take a little longer to investigate.</p>
      </article>

      <article class="info-card">
        <span class="info-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg></span>
        <h3>Location</h3>
        <p class="info-main">Operated from Singapore</p>
        <p class="info-sub">Serving users worldwide with fully browser-based tools.</p>
      </article>
    </section>

    <section class="help-grid">
      <div class="help-box">
        <h2>FAQ and help</h2>
        <p>You may find a faster answer in our FAQ and product explanations.</p>
        <a class="button button-ghost" href="/#faqs">View FAQs →</a>
      </div>
      <div class="help-box">
        <h2>Browser compatibility and privacy</h2>
        <p>Toolbox Image works best in current versions of Chrome, Edge, Safari, and Firefox. Browser-based tools process files locally whenever possible.</p>
        <p class="info-sub">For details on cookies and analytics, review our <a href="/privacy">Privacy Policy</a> and <a href="/cookie">Cookie Policy</a>.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .support-wrap{max-width:960px;margin:0 auto;padding:72px 24px 90px}
  .support-hero{text-align:center;max-width:680px;margin:0 auto 52px}
  .support-hero .eyebrow{display:inline-block;color:#2563eb;font-size:12px;font-weight:800;letter-spacing:.14em;margin-bottom:14px}
  .support-hero h1{font-size:clamp(34px,5vw,52px);line-height:1.08;letter-spacing:-.03em;margin:0 0 18px;color:#111827}
  .support-hero .lede{font-size:18px;line-height:1.65;color:#667085;margin:0 0 28px}
  .contact-mail{display:inline-flex;align-items:center;gap:10px;background:#2563eb;color:#fff;text-decoration:none;font-weight:700;font-size:16px;padding:14px 24px;border-radius:12px;box-shadow:0 10px 24px rgba(37,99,235,.28);transition:transform .15s ease,box-shadow .15s ease}
  .contact-mail svg{width:20px;height:20px}
  .contact-mail:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(37,99,235,.34)}

  .info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:46px}
  .info-card{background:#fff;border:1px solid #e8edf4;border-radius:16px;padding:26px 22px;transition:border-color .15s ease,box-shadow .15s ease}
  .info-card:hover{border-color:#c7d7f0;box-shadow:0 14px 30px rgba(16,24,40,.06)}
  .info-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:#eff6ff;color:#2563eb;margin-bottom:16px}
  .info-icon svg{width:22px;height:22px}
  .info-card h3{font-size:17px;margin:0 0 10px;color:#101828}
  .info-main{font-size:15px;color:#344054;margin:0 0 6px;font-weight:600}
  .info-main a{color:#2563eb;text-decoration:none}
  .info-main a:hover{text-decoration:underline}
  .info-sub{font-size:13.5px;color:#667085;margin:0;line-height:1.6}

  .help-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .help-box{background:#fff;border:1px solid #e8edf4;border-radius:16px;padding:28px 26px}
  .help-box h2{font-size:20px;margin:0 0 12px;color:#101828}
  .help-box p{font-size:15px;color:#475467;line-height:1.65;margin:0 0 16px}
  .help-box p a{color:#2563eb;text-decoration:none}
  .help-box p a:hover{text-decoration:underline}
  .button{display:inline-flex;align-items:center;font-weight:700;font-size:14px;text-decoration:none;padding:11px 20px;border-radius:10px;transition:all .15s ease}
  .button-ghost{background:#eff6ff;color:#2563eb}
  .button-ghost:hover{background:#dbeafe}

  @media (max-width:760px){
    .info-grid{grid-template-columns:1fr}
    .help-grid{grid-template-columns:1fr}
    .support-wrap{padding:48px 18px 64px}
  }
</style>
