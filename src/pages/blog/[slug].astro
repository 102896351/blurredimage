---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const url = `https://img.toolbox168.xyz/blog/${post.slug}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: 'en',
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: 'https://img.toolbox168.xyz/img/og-cover.jpg',
  publisher: {
    '@type': 'Organization',
    name: 'Toolbox Image',
    url: 'https://img.toolbox168.xyz',
    logo: { '@type': 'ImageObject', url: 'https://img.toolbox168.xyz/img/logo-512.png' },
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://img.toolbox168.xyz/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://img.toolbox168.xyz/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
---
<Base
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.slug}`}
  lang="en"
  altLang={null}
  schema={[articleSchema, breadcrumb]}
>
  <article class="page-wrap post">
    <header class="post-header">
      <a class="back-link" href="/blog">← All articles</a>
      <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="tags">
        {post.data.tags.map((tag) => (
          <a href={`/blog/tags/${tag}`}>#{tag}</a>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <AdSlot slot={ADSENSE_SLOTS.article} />
    <footer class="post-footer">
      <h2>Related tools</h2>
      <div class="button-row">
        <a class="button button-primary" href="/blur-image">Blur part of an image</a>
        <a class="button button-ghost" href="/compress-image">Compress images</a>
      </div>
    </footer>
  </article>
</Base>
