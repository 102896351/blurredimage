---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../../../config';

export async function getStaticPaths() {
  const posts = await getCollection('blogZh', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const url = `https://toolbox168.com/zh/blog/${post.slug}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: 'zh-CN',
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: 'https://toolbox168.com/img/og-cover.jpg',
  publisher: {
    '@type': 'Organization',
    name: 'Toolbox Image',
    url: 'https://toolbox168.com',
    logo: { '@type': 'ImageObject', url: 'https://toolbox168.com/img/logo-512.png' },
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://toolbox168.com/zh/' },
    { '@type': 'ListItem', position: 2, name: '博客', item: 'https://toolbox168.com/zh/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.slug}`}
  lang="zh"
  altLang={`/blog/${post.slug}`}
  schema={[articleSchema, breadcrumb]}
>
  <article class="page-wrap post">
    <header class="post-header">
      <a class="back-link" href="/zh/blog">← 返回文章列表</a>
      <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="tags">
        {post.data.tags.map((tag) => (
          <a href={`/blog/tags/${tag}`}>#{tag}</a>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <AdSlot slot={ADSENSE_SLOTS.article} />
    <footer class="post-footer">
      <h2>相关工具</h2>
      <div class="button-row">
        <a class="button button-primary" href="/zh/blur-image">模糊图片局部</a>
        <a class="button button-ghost" href="/zh/compress-image">压缩图片</a>
      </div>
    </footer>
  </article>
</Base>
