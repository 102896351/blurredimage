---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const collection = zh ? 'blogZh' : 'blog';
const posts = (await getCollection(collection, ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
// Chinese list page shows the Chinese posts and links to their /zh/blog/ URLs.
const postHref = (slug: string) => (zh ? `/zh/blog/${slug}` : `/blog/${slug}`);
---
<Base
  title={zh ? '图片隐私与编辑指南 | Toolbox Image 博客' : 'Image Privacy & Editing Guides | Toolbox Image Blog'}
  description={zh ? '关于模糊、马赛克、压缩、调整尺寸和分享前保护照片的实用指南（英文文章）。' : 'Practical guides on blurring, pixelating, compressing, resizing, and protecting photos before you share them online.'}
  path="/blog"
  lang={lang}
>
  <section class="page-wrap">
    <span class="eyebrow">BLOG</span>
    <h1>{zh ? '图片隐私与编辑指南' : 'Image Privacy & Editing Guides'}</h1>
    <p class="lede">
      {zh
        ? '隐藏敏感信息、提升清晰度、分享前处理图片的实用分步指南。'
        : 'Practical, step-by-step guides for hiding sensitive details, enhancing clarity, and preparing images before you share them.'}
    </p>
    <div class="blog-grid">
      {posts.map((post) => (
        <article class="blog-card">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
          <h2><a href={postHref(post.slug)}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          <div class="tags">
            {post.data.tags.slice(0, 3).map((tag) => (
              <a href={`/blog/tags/${tag}`}>#{tag}</a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
