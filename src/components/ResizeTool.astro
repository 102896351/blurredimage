---
import { type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---
<section class="special-tool utility-tool"><div class="special-head"><div><span class="eyebrow">IMAGE RESIZER</span><h2>{zh ? '调整图片尺寸' : 'Resize image'}</h2><p>{zh ? '输入目标宽高，锁定比例后导出。' : 'Enter the target width and height, lock the ratio and export.'}</p></div><label class="upload-mini">{zh ? '选择图片' : 'Choose image'}<input id="resize-file" type="file" accept="image/*" hidden /></label></div><div class="utility-empty" id="resize-empty">{zh ? '上传图片后设置目标尺寸' : 'Upload an image to set the target size'}</div><div id="resize-work" hidden><div class="stats-row"><div><span>{zh ? '当前尺寸' : 'Current size'}</span><strong id="resize-current">—</strong></div><div><span>{zh ? '输出尺寸' : 'Output size'}</span><strong id="resize-output">—</strong></div></div><div class="dimension-controls"><label>{zh ? '宽度' : 'Width'}<input id="resize-width" type="number" min="1" /></label><button id="resize-lock" class="icon-button" type="button">🔒</button><label>{zh ? '高度' : 'Height'}<input id="resize-height" type="number" min="1" /></label></div><div class="preset-row"><button data-size="640" type="button">640px</button><button data-size="1080" type="button">1080px</button><button data-size="1920" type="button">1920px</button></div><button class="button button-primary" id="resize-download" type="button">{zh ? '调整尺寸并下载' : 'Resize & download'}</button><canvas id="resize-canvas" hidden></canvas></div></section>
<script>
const ri=document.querySelector('#resize-file'),rw=document.querySelector('#resize-work'),re=document.querySelector('#resize-empty'),rwidth=document.querySelector('#resize-width'),rheight=document.querySelector('#resize-height'),rlock=document.querySelector('#resize-lock'),rout=document.querySelector('#resize-output'),rcurrent=document.querySelector('#resize-current'),rc=document.querySelector('#resize-canvas');let rimg=null,locked=true;
function resizeOutput(){if(!rimg)return;if(locked&&document.activeElement===rwidth)rheight.value=Math.max(1,Math.round(Number(rwidth.value)*rimg.height/rimg.width));if(locked&&document.activeElement===rheight)rwidth.value=Math.max(1,Math.round(Number(rheight.value)*rimg.width/rimg.height));rout.textContent=`${rwidth.value} × ${rheight.value}px`}
ri.addEventListener('change',()=>{const f=ri.files?.[0];if(!f)return;const r=new FileReader();r.onload=()=>{rimg=new Image();rimg.onload=()=>{re.hidden=true;rw.hidden=false;rcurrent.textContent=`${rimg.width} × ${rimg.height}px`;rwidth.value=rimg.width;rheight.value=rimg.height;resizeOutput()};rimg.src=r.result};r.readAsDataURL(f)});rlock.addEventListener('click',()=>{locked=!locked;rlock.textContent=locked?'🔒':'🔓'});rwidth.addEventListener('input',resizeOutput);rheight.addEventListener('input',resizeOutput);document.querySelectorAll('[data-size]').forEach(b=>b.addEventListener('click',()=>{rwidth.value=b.dataset.size;resizeOutput()}));document.querySelector('#resize-download').addEventListener('click',()=>{rc.width=Number(rwidth.value);rc.height=Number(rheight.value);rc.getContext('2d').drawImage(rimg,0,0,rc.width,rc.height);rc.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='toolbox-resized.png';a.click()})});
</script>
