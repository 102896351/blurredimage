---
import { type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---
<section class="special-tool utility-tool"><div class="special-head"><div><span class="eyebrow">CROP & TRANSFORM</span><h2>{zh ? '裁剪、旋转和翻转' : 'Crop, rotate and flip'}</h2><p>{zh ? '先调整构图和方向，再导出图片。' : 'Adjust the framing and orientation first, then export.'}</p></div><label class="upload-mini">{zh ? '选择图片' : 'Choose image'}<input id="crop-file" type="file" accept="image/*" hidden /></label></div><div class="utility-empty" id="crop-empty">{zh ? '上传图片后开始裁剪和调整方向' : 'Upload an image to start cropping and rotating'}</div><div id="crop-work" hidden><div class="crop-stage"><canvas id="crop-canvas"></canvas></div><div class="preset-row"><button data-ratio="free" type="button">{zh ? '自由' : 'Free'}</button><button data-ratio="1" type="button">1:1</button><button data-ratio="1.777" type="button">16:9</button><button data-ratio="1.333" type="button">4:3</button></div><div class="button-row transform-row"><button class="button button-ghost" id="crop-left" type="button">↶ {zh ? '左转' : 'Left'}</button><button class="button button-ghost" id="crop-right" type="button">↷ {zh ? '右转' : 'Right'}</button><button class="button button-ghost" id="crop-x" type="button">↔ {zh ? '水平翻转' : 'Flip H'}</button><button class="button button-ghost" id="crop-y" type="button">↕ {zh ? '垂直翻转' : 'Flip V'}</button></div><button class="button button-primary" id="crop-download" type="button">{zh ? '导出图片' : 'Export image'}</button></div></section>
<script>
const cropInput=document.querySelector('#crop-file'),cropEmpty=document.querySelector('#crop-empty'),cropWork=document.querySelector('#crop-work'),cropCanvas=document.querySelector('#crop-canvas'),cropCtx=cropCanvas.getContext('2d');let cropImg=null,cropRot=0,cropFx=1,cropFy=1,cropRatio='free';
function drawCrop(){if(!cropImg)return;const swap=Math.abs(cropRot)%180===90;cropCanvas.width=swap?cropImg.height:cropImg.width;cropCanvas.height=swap?cropImg.width:cropImg.height;cropCtx.save();cropCtx.translate(cropCanvas.width/2,cropCanvas.height/2);cropCtx.rotate(cropRot*Math.PI/180);cropCtx.scale(cropFx,cropFy);cropCtx.drawImage(cropImg,-cropImg.width/2,-cropImg.height/2);cropCtx.restore()}
cropInput.addEventListener('change',()=>{const f=cropInput.files?.[0];if(!f)return;const r=new FileReader();r.onload=()=>{cropImg=new Image();cropImg.onload=()=>{cropEmpty.hidden=true;cropWork.hidden=false;drawCrop()};cropImg.src=r.result};r.readAsDataURL(f)});document.querySelector('#crop-left').addEventListener('click',()=>{cropRot-=90;drawCrop()});document.querySelector('#crop-right').addEventListener('click',()=>{cropRot+=90;drawCrop()});document.querySelector('#crop-x').addEventListener('click',()=>{cropFx*=-1;drawCrop()});document.querySelector('#crop-y').addEventListener('click',()=>{cropFy*=-1;drawCrop()});document.querySelectorAll('[data-ratio]').forEach(b=>b.addEventListener('click',()=>{cropRatio=b.dataset.ratio;document.querySelectorAll('[data-ratio]').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')}));document.querySelector('#crop-download').addEventListener('click',()=>cropCanvas.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='toolbox-transformed.png';a.click()}));
</script>
