---
import { type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---
<section class="special-tool utility-tool"><div class="special-head"><div><span class="eyebrow">IMAGE COMPRESSION</span><h2>{zh ? '压缩图片' : 'Compress image'}</h2><p>{zh ? '调整质量和格式，减小文件体积。' : 'Adjust quality and format to shrink the file size.'}</p></div><label class="upload-mini">{zh ? '选择图片' : 'Choose image'}<input id="compress-file" type="file" accept="image/*" hidden /></label></div><div class="utility-empty" id="compress-empty">{zh ? '上传图片后查看压缩前后的文件大小' : 'Upload an image to compare file size before and after'}</div><div id="compress-work" hidden><div class="stats-row"><div><span>{zh ? '原始大小' : 'Original size'}</span><strong id="compress-before">—</strong></div><div><span>{zh ? '预计大小' : 'Estimated size'}</span><strong id="compress-after">—</strong></div></div><div class="special-controls"><label>{zh ? '质量' : 'Quality'} <output id="compress-quality-value">82%</output><input id="compress-quality" type="range" min="10" max="100" value="82" /></label><select id="compress-format"><option value="image/webp">WebP</option><option value="image/jpeg">JPG</option><option value="image/png">PNG</option></select><button class="button button-primary" id="compress-download" type="button">{zh ? '压缩并下载' : 'Compress & download'}</button></div><canvas id="compress-canvas" hidden></canvas><p class="editor-status" id="compress-status">{zh ? '所有处理在浏览器本地完成。' : 'All processing happens locally in your browser.'}</p></div></section>
<script>
const ci=document.querySelector('#compress-file'), cw=document.querySelector('#compress-work'), ce=document.querySelector('#compress-empty'), cq=document.querySelector('#compress-quality'),cqv=document.querySelector('#compress-quality-value'),cf=document.querySelector('#compress-format'),cc=document.querySelector('#compress-canvas'),cb=document.querySelector('#compress-before'),ca=document.querySelector('#compress-after');let cimg=null,cfile=null;
function compressPreview(){if(!cimg)return;cc.width=cimg.width;cc.height=cimg.height;cc.getContext('2d').drawImage(cimg,0,0);cc.toBlob(b=>{ca.textContent=b?`${(b.size/1024).toFixed(1)} KB`:'—'},cf.value,Number(cq.value)/100)}
ci.addEventListener('change',()=>{cfile=ci.files?.[0];if(!cfile)return;const r=new FileReader();r.onload=()=>{cimg=new Image();cimg.onload=()=>{ce.hidden=true;cw.hidden=false;cb.textContent=`${(cfile.size/1024).toFixed(1)} KB`;compressPreview()};cimg.src=r.result};r.readAsDataURL(cfile)});cq.addEventListener('input',()=>{cqv.value=`${cq.value}%`;compressPreview()});cf.addEventListener('change',compressPreview);document.querySelector('#compress-download').addEventListener('click',()=>cc.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=`toolbox-compressed.${cf.value.split('/')[1].replace('jpeg','jpg')}`;a.click()},cf.value,Number(cq.value)/100));
</script>
