---
import { editorStrings, editorMsgs, type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const s = editorStrings[lang];
const zh = lang === 'zh';
---
<section class="editor-shell" id="image-editor">
  <div class="editor-topbar">
    <div><span class="eyebrow">LOCAL IMAGE EDITOR</span><h2>{zh ? '涂抹需要隐藏的区域' : 'Brush over the areas to hide'}</h2><p>{zh ? '用画笔、矩形或套索覆盖车牌、人脸、文字和敏感细节。图片留在浏览器中。' : 'Cover license plates, faces, text and sensitive details with the brush, rectangle or lasso. Images stay in your browser.'}</p></div>
    <button class="button button-ghost" id="reset-btn" type="button">{s.reset}</button>
  </div>

  <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label={s.choose}>
    <input id="file-input" type="file" accept="image/*" multiple hidden />
    <div class="upload-icon">↑</div>
    <strong>{zh ? '点击选择图片，或拖拽图片到这里' : 'Click to select an image, or drop it here'}</strong>
    <span>{s.dropHintFull}</span>
    <button class="button button-primary" id="choose-btn" type="button">{s.choose}</button>
  </div>

  <div class="editor-layout" id="workspace" hidden>
    <aside class="tool-panel">
      <div class="panel-section"><span class="panel-label">{s.editMode}</span><div class="segmented"><button class="seg active" data-mode="brush" type="button">{s.brush}</button><button class="seg" data-mode="rect" type="button">{s.rect}</button><button class="seg" data-mode="lasso" type="button">{s.lasso}</button></div></div>
      <div class="panel-section"><span class="panel-label">{s.effect}</span><div class="segmented grid2" id="effect-group"><button class="seg active" data-effect="gaussian" type="button">{s.gaussian}</button><button class="seg" data-effect="pixel" type="button">{s.pixel}</button><button class="seg" data-effect="noise" type="button">{s.noise}</button><button class="seg" data-effect="cover" type="button">{s.cover}</button></div></div>
      <label class="range-row">{s.strength} <output id="strength-value">18</output><input id="strength" type="range" min="2" max="60" value="18" /></label>
      <label class="range-row" id="brush-size-row">{s.brushSize} <output id="brush-value">70</output><input id="brush-size" type="range" min="12" max="240" value="70" /></label>
      <div class="button-row"><button class="button button-ghost" id="undo-btn" type="button" disabled>{s.undo}</button><button class="button button-ghost" id="redo-btn" type="button" disabled>{s.redo}</button></div>
      <button class="button button-ghost full" id="clear-btn" type="button">{s.clearAll}</button>
      <div class="panel-section transform-tools"><span class="panel-label">{s.transform}</span><div class="button-row"><button class="icon-button" data-transform="rotate-left" type="button">↶</button><button class="icon-button" data-transform="rotate-right" type="button">↷</button><button class="icon-button" data-transform="flip-x" type="button">↔</button><button class="icon-button" data-transform="flip-y" type="button">↕</button></div></div>
      <div class="panel-section"><span class="panel-label">{s.export}</span><select id="format-select"><option value="image/png">PNG</option><option value="image/jpeg">JPG</option><option value="image/webp">WebP</option></select><label class="range-row">{s.quality} <output id="quality-value">90%</output><input id="quality" type="range" min="40" max="100" value="90" /></label><button class="button button-primary full" id="download-btn" type="button">{s.download}</button></div>
      <p class="editor-status" id="editor-status" role="status"></p>
    </aside>
    <div class="canvas-stage"><div class="canvas-wrap"><canvas id="canvas"></canvas><div class="selection-hint">{s.brushHint}</div></div><div class="stage-footer"><span id="image-info"></span><label>{s.zoom} <input id="zoom" type="range" min="30" max="140" value="100" /></label></div></div>
  </div>
</section>
<script type="application/json" id="rb-msgs" set:html={JSON.stringify(editorMsgs[lang])} />
<script>
  const M = JSON.parse(document.querySelector('#rb-msgs')!.textContent!);
  const fileInput = document.querySelector('#file-input');
  const chooseBtn = document.querySelector('#choose-btn');
  const dropzone = document.querySelector('#dropzone');
  const workspace = document.querySelector('#workspace');
  const canvas = document.querySelector('#canvas');
  const ctx = canvas.getContext('2d', { willReadFrequently: true });
  const status = document.querySelector('#editor-status');
  let effectType = 'gaussian';
  const strength = document.querySelector('#strength');
  const brushSize = document.querySelector('#brush-size');
  const format = document.querySelector('#format-select');
  const quality = document.querySelector('#quality');
  const zoom = document.querySelector('#zoom');
  const history = [];
  const future = [];
  let image = null;
  let originalFile = null;
  let drawing = false;
  let start = null;
  let last = null;
  let mode = 'brush';
  let selection = null;
  let rotation = 0;
  let flipX = 1;
  let flipY = 1;

  const setStatus = (message) => { status.textContent = message; };
  setStatus(M.idle);
  document.querySelector('#image-info').textContent = M.waiting;
  const snapshot = () => ctx.getImageData(0, 0, canvas.width, canvas.height);
  const saveHistory = () => { history.push(snapshot()); if (history.length > 20) history.shift(); future.length = 0; updateHistoryButtons(); };
  const restore = (state) => { canvas.width = state.width; canvas.height = state.height; ctx.putImageData(state, 0, 0); updateInfo(); };
  const updateHistoryButtons = () => { document.querySelector('#undo-btn').disabled = history.length === 0; document.querySelector('#redo-btn').disabled = future.length === 0; };
  const updateInfo = () => { document.querySelector('#image-info').textContent = image ? `${canvas.width} × ${canvas.height}px · ${originalFile?.name || 'image'}` : M.waiting; };
  const point = (event) => { const r = canvas.getBoundingClientRect(); return { x: Math.max(0, Math.min(canvas.width, (event.clientX - r.left) * canvas.width / r.width)), y: Math.max(0, Math.min(canvas.height, (event.clientY - r.top) * canvas.height / r.height)) }; };
  const drawBase = () => { if (!image) return; ctx.save(); ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.translate(canvas.width / 2, canvas.height / 2); ctx.rotate(rotation * Math.PI / 180); ctx.scale(flipX, flipY); ctx.drawImage(image, -canvas.width / 2, -canvas.height / 2, canvas.width, canvas.height); ctx.restore(); };
  const MAX_DIM = 2000;
  const fitSize = (w, h) => { const s = Math.min(1, MAX_DIM / Math.max(w, h)); return s < 1 ? [Math.round(w * s), Math.round(h * s)] : [w, h]; };
  const applyEffect = (source, type, amount) => {
    const w = source.width, h = source.height, sctx = source.getContext('2d');
    if (type === 'cover') { sctx.fillStyle = '#111827'; sctx.fillRect(0, 0, w, h); return; }
    if (type === 'pixel') {
      const scale = Math.max(2, amount / 2);
      const small = document.createElement('canvas');
      small.width = Math.max(1, Math.ceil(w / scale)); small.height = Math.max(1, Math.ceil(h / scale));
      const sc = small.getContext('2d'); sc.imageSmoothingEnabled = false; sc.drawImage(source, 0, 0, small.width, small.height);
      sctx.imageSmoothingEnabled = false; sctx.clearRect(0, 0, w, h); sctx.drawImage(small, 0, 0, w, h); sctx.imageSmoothingEnabled = true; return;
    }
    if (type === 'gaussian') { const blurred = document.createElement('canvas'); blurred.width = w; blurred.height = h; const bx = blurred.getContext('2d'); bx.filter = `blur(${Math.max(1, amount / 3)}px)`; bx.drawImage(source, 0, 0); sctx.clearRect(0, 0, w, h); sctx.drawImage(blurred, 0, 0); return; }
    // noise — fast single pass, no neighbour window
    const data = sctx.getImageData(0, 0, w, h), amp = (Number(amount) || 10) * 2;
    for (let i = 0; i < data.data.length; i += 4) { const n = (Math.random() - .5) * amp; data.data[i] = Math.max(0, Math.min(255, data.data[i] + n)); data.data[i + 1] = Math.max(0, Math.min(255, data.data[i + 1] + n)); data.data[i + 2] = Math.max(0, Math.min(255, data.data[i + 2] + n)); }
    sctx.putImageData(data, 0, 0);
  };
  const applyRegion = (region) => { if (!region) return; const x = Math.max(0, Math.floor(region.x)), y = Math.max(0, Math.floor(region.y)); const w = Math.min(canvas.width - x, Math.ceil(region.w)), h = Math.min(canvas.height - y, Math.ceil(region.h)); if (w < 2 || h < 2) return; const temp = document.createElement('canvas'); temp.width = w; temp.height = h; temp.getContext('2d').drawImage(canvas, x, y, w, h, 0, 0, w, h); applyEffect(temp, effectType, Number(strength.value)); ctx.drawImage(temp, 0, 0, w, h, x, y, w, h); };
  const applyBrush = (a, b) => {
    const r = Number(brushSize.value) / 2;
    const minX = Math.min(a.x, b.x) - r, minY = Math.min(a.y, b.y) - r;
    const w = Math.abs(a.x - b.x) + r * 2, h = Math.abs(a.y - b.y) + r * 2;
    const temp = document.createElement('canvas'); temp.width = Math.ceil(w); temp.height = Math.ceil(h);
    temp.getContext('2d').drawImage(canvas, minX, minY, w, h, 0, 0, w, h);
    applyEffect(temp, effectType, Number(strength.value));
    // continuous stroke mask (no gaps on fast moves)
    const mask = document.createElement('canvas'); mask.width = Math.ceil(w); mask.height = Math.ceil(h);
    const mctx = mask.getContext('2d');
    mctx.strokeStyle = '#fff'; mctx.lineWidth = brushSize.value; mctx.lineCap = 'round'; mctx.lineJoin = 'round';
    mctx.beginPath(); mctx.moveTo(a.x - minX, a.y - minY); mctx.lineTo(b.x - minX, b.y - minY); mctx.stroke();
    const out = document.createElement('canvas'); out.width = Math.ceil(w); out.height = Math.ceil(h);
    const octx = out.getContext('2d'); octx.drawImage(temp, 0, 0); octx.globalCompositeOperation = 'destination-in'; octx.drawImage(mask, 0, 0);
    ctx.drawImage(out, minX, minY);
  };
  const loadFile = (file) => { if (!file?.type.startsWith('image/')) return setStatus(M.pickImage); if (file.size > 20 * 1024 * 1024) return setStatus(M.tooLarge); originalFile = file; const reader = new FileReader(); reader.onload = () => { image = new Image(); image.onload = () => { const [fw, fh] = fitSize(image.width, image.height); canvas.width = fw; canvas.height = fh; drawBase(); history.length = 0; future.length = 0; workspace.hidden = false; dropzone.hidden = true; updateInfo(); updateHistoryButtons(); setStatus(M.loaded); }; image.src = reader.result; }; reader.readAsDataURL(file); };
  chooseBtn.addEventListener('click', () => fileInput.click()); dropzone.addEventListener('click', (e) => { if (e.target !== chooseBtn) fileInput.click(); }); fileInput.addEventListener('change', () => loadFile(fileInput.files?.[0])); ['dragenter', 'dragover'].forEach((event) => dropzone.addEventListener(event, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); })); ['dragleave', 'drop'].forEach((event) => dropzone.addEventListener(event, (e) => { e.preventDefault(); dropzone.classList.remove('dragover'); })); dropzone.addEventListener('drop', (e) => loadFile(e.dataTransfer.files?.[0])); window.addEventListener('paste', (e) => { const file = [...(e.clipboardData?.files || [])][0]; if (file) loadFile(file); });
  document.querySelectorAll('[data-mode]').forEach((button) => button.addEventListener('click', () => { mode = button.dataset.mode; document.querySelectorAll('[data-mode]').forEach((b) => b.classList.toggle('active', b === button)); }));
  document.querySelectorAll('[data-effect]').forEach((button) => button.addEventListener('click', () => { effectType = button.dataset.effect; document.querySelectorAll('[data-effect]').forEach((b) => b.classList.toggle('active', b === button)); }));
  strength.addEventListener('input', () => document.querySelector('#strength-value').value = strength.value); brushSize.addEventListener('input', () => document.querySelector('#brush-value').value = brushSize.value); quality.addEventListener('input', () => document.querySelector('#quality-value').value = `${quality.value}%`); zoom.addEventListener('input', () => canvas.style.width = `${zoom.value}%`);
  canvas.addEventListener('pointerdown', (e) => { if (!image) return; canvas.setPointerCapture(e.pointerId); saveHistory(); drawing = true; start = point(e); last = start; selection = { x: start.x, y: start.y, w: 0, h: 0 }; });
  canvas.addEventListener('pointermove', (e) => { if (!drawing) return; const p = point(e); if (mode === 'brush') applyBrush(last, p); else selection = { x: Math.min(start.x, p.x), y: Math.min(start.y, p.y), w: Math.abs(p.x - start.x), h: Math.abs(p.y - start.y) }; last = p; });
  canvas.addEventListener('pointerup', () => { if (!drawing) return; drawing = false; if (mode !== 'brush') applyRegion(selection); selection = null; });
  document.querySelector('#undo-btn').addEventListener('click', () => { if (!history.length) return; future.push(snapshot()); restore(history.pop()); updateHistoryButtons(); }); document.querySelector('#redo-btn').addEventListener('click', () => { if (!future.length) return; history.push(snapshot()); restore(future.pop()); updateHistoryButtons(); });
  document.querySelector('#clear-btn').addEventListener('click', () => { if (!image) return; saveHistory(); drawBase(); setStatus(M.cleared); }); document.querySelector('#reset-btn').addEventListener('click', () => { image = null; originalFile = null; workspace.hidden = true; dropzone.hidden = false; fileInput.value = ''; rotation = 0; flipX = 1; flipY = 1; history.length = 0; future.length = 0; updateHistoryButtons(); setStatus(M.idle); });
  document.querySelectorAll('[data-transform]').forEach((button) => button.addEventListener('click', () => { if (!image) return; saveHistory(); const t = button.dataset.transform; if (t === 'rotate-left') rotation -= 90; if (t === 'rotate-right') rotation += 90; if (t === 'flip-x') flipX *= -1; if (t === 'flip-y') flipY *= -1; if (Math.abs(rotation) % 180 === 90) [canvas.width, canvas.height] = [canvas.height, canvas.width]; drawBase(); setStatus(M.transformed); updateInfo(); }));
  document.querySelector('#download-btn').addEventListener('click', () => { if (!image) return; canvas.toBlob((blob) => { if (!blob) return; const link = document.createElement('a'); link.href = URL.createObjectURL(blob); const ext = format.value.split('/')[1].replace('jpeg', 'jpg'); link.download = `toolbox-edited.${ext}`; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 1000); setStatus(M.exported); }, format.value, Number(quality.value) / 100); });
</script>
