---
import { type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';
---
<section class="special-tool full-blur-tool">
  <div class="special-head"><div><span class="eyebrow">FULL IMAGE BLUR</span><h2>{zh ? '整张图片模糊' : 'Blur the whole image'}</h2><p>{zh ? '适合背景虚化、预告图和整体柔化，不需要选择区域。' : 'Great for background softening, teasers and gentle overall blur — no selection needed.'}</p></div><label class="upload-mini">{zh ? '选择图片' : 'Choose image'}<input id="full-file" type="file" accept="image/*" hidden /></label></div>
  <div class="full-empty" id="full-empty"><strong>{zh ? '拖入图片，查看整图模糊效果' : 'Drop an image to see the full-image blur'}</strong><span>{zh ? '图片只在浏览器中处理' : 'Images are processed in your browser only'}</span></div>
  <div class="full-work" id="full-work" hidden><div class="compare-grid"><figure><figcaption>{zh ? '原图' : 'Original'}</figcaption><img id="full-original" alt={zh ? '原图预览' : 'Original preview'} / width="800" height="450" /></figure><figure><figcaption>{zh ? '模糊结果' : 'Blurred result'}</figcaption><canvas id="full-result"></canvas></figure></div><div class="special-controls"><label>{zh ? '模糊强度' : 'Blur strength'} <output id="full-strength-value">18</output><input id="full-strength" type="range" min="1" max="45" value="18" /></label><select id="full-effect"><option value="gaussian">{zh ? '高斯模糊' : 'Gaussian blur'}</option><option value="pixel">{zh ? '像素化' : 'Pixelate'}</option><option value="soft">{zh ? '柔和虚化' : 'Soft blur'}</option></select><button class="button button-primary" id="full-download" type="button">{zh ? '下载结果' : 'Download result'}</button></div><p class="editor-status" id="full-status">{zh ? '拖动滑块实时预览。' : 'Drag the slider to preview in real time.'}</p></div>
</section>
<script>
const fullInput=document.querySelector('#full-file'), fullEmpty=document.querySelector('#full-empty'), fullWork=document.querySelector('#full-work'), fullOriginal=document.querySelector('#full-original'), fullCanvas=document.querySelector('#full-result'), fullCtx=fullCanvas.getContext('2d'), fullStrength=document.querySelector('#full-strength'), fullValue=document.querySelector('#full-strength-value'), fullEffect=document.querySelector('#full-effect'), fullDownload=document.querySelector('#full-download'); let fullImage=null;
const renderFull=()=>{if(!fullImage)return; fullCanvas.width=fullImage.width;fullCanvas.height=fullImage.height;fullCtx.filter=fullEffect.value==='gaussian'?`blur(${fullStrength.value}px)`:fullEffect.value==='soft'?`blur(${Math.max(2,Number(fullStrength.value)/2)}px)`:'none';fullCtx.drawImage(fullImage,0,0);fullCtx.filter='none';if(fullEffect.value==='pixel'){const s=Math.max(3,Number(fullStrength.value)/2),small=document.createElement('canvas');small.width=Math.ceil(fullCanvas.width/s);small.height=Math.ceil(fullCanvas.height/s);const sc=small.getContext('2d');sc.imageSmoothingEnabled=false;sc.drawImage(fullImage,0,0,small.width,small.height);fullCtx.imageSmoothingEnabled=false;fullCtx.clearRect(0,0,fullCanvas.width,fullCanvas.height);fullCtx.drawImage(small,0,0,fullCanvas.width,fullCanvas.height);fullCtx.imageSmoothingEnabled=true;}};
fullInput.addEventListener('change',()=>{const file=fullInput.files?.[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{fullImage=new Image();fullImage.onload=()=>{fullOriginal.src=reader.result;fullEmpty.hidden=true;fullWork.hidden=false;renderFull()};fullImage.src=reader.result};reader.readAsDataURL(file)});fullStrength.addEventListener('input',()=>{fullValue.value=fullStrength.value;renderFull()});fullEffect.addEventListener('change',renderFull);fullDownload.addEventListener('click',()=>fullCanvas.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='toolbox-full-blur.png';a.click()}));
</script>
